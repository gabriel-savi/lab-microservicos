{
  "info": {
    "_postman_id": "ecommerce-microservices-lab",
    "name": "E-commerce Microservices Lab",
    "description": "Fluxo end-to-end: catálogo, carrinho, pedido (síncrono) e eventos assíncronos (NF, logística, garantia). Gateway em http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "cartId",
      "value": "postman-cart-1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Catálogo",
      "item": [
        {
          "name": "Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/catalogo/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "catalogo", "products"] }
          }
        },
        {
          "name": "Criar produto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"SSD 1TB\",\n  \"price\": 600.0,\n  \"stock\": 25,\n  \"extendedWarrantyEligible\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/catalogo/products", "host": ["{{baseUrl}}"], "path": ["api", "v1", "catalogo", "products"] }
          }
        }
      ]
    },
    {
      "name": "Carrinho",
      "item": [
        {
          "name": "Adicionar item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": 1,\n  \"quantity\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/carrinho/carts/{{cartId}}/items", "host": ["{{baseUrl}}"], "path": ["api", "v1", "carrinho", "carts", "{{cartId}}", "items"] }
          }
        },
        {
          "name": "Ver carrinho",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/carrinho/carts/{{cartId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "carrinho", "carts", "{{cartId}}"] }
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido (checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.orderId) pm.collectionVariables.set('orderId', data.orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cartId\": \"{{cartId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/pedidos/orders", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos", "orders"] }
          }
        },
        {
          "name": "Consultar pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/pedidos/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos", "orders", "{{orderId}}"] }
          }
        }
      ]
    },
    {
      "name": "Observabilidade",
      "item": [
        {
          "name": "Métricas Prometheus (order)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/pedidos/metrics", "host": ["{{baseUrl}}"], "path": ["api", "v1", "pedidos", "metrics"] }
          }
        }
      ]
    }
  ]
}